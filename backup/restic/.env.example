# Copy this file to .env and set real values before running any script
# here.
#
# For a real VPS, point RESTIC_REPOSITORY at off-box storage (S3, B2,
# SFTP, ...) — see https://restic.readthedocs.io/en/stable/030_preparing_a_new_repo.html.
# A local path works for testing but defeats the point of backup (it's
# the same disk everything else is on).
RESTIC_REPOSITORY=/var/backups/vps-restic
RESTIC_PASSWORD=ChangeMe_ResticRepoPassword123

# Must match databases/postgres/.env.
POSTGRES_CONTAINER=postgres
POSTGRES_USER=appuser
POSTGRES_DB=appdb

# Must match apps/apex/.env's ORACLE_PASSWORD (the SYS password).
APEX_DB_CONTAINER=apex-db
ORACLE_PASSWORD=
# Comma-separated list of your OWN application schemas to back up — not
# APEX_* internal schemas, which come back by reinstalling APEX, not by
# restoring a dump. Set this to whatever schema(s) your app actually
# created.
ORACLE_BACKUP_SCHEMAS=

KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6
