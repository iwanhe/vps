# Copy this file to .env and set real values before `docker compose up`.
# Each *_DOMAIN must already have a DNS A/AAAA record pointing at this
# VPS's public IP, and ports 80/443 must be open (see ../../../docs/security/baseline.md)
# — Caddy's automatic HTTPS (Let's Encrypt) needs both to issue a certificate.

ACME_EMAIL=you@example.com
NEXTJS_DOMAIN=app.example.com
APEX_DOMAIN=apex.example.com
