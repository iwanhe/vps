# Copy this file to .env and change every value before `docker compose up`.

# SYS/SYSTEM password for the database, and the password ORDS uses to
# install itself (as SYS) the first time it connects.
ORACLE_PASSWORD=ChangeMe_DbSys123

# Oracle APEX workspace admin (INTERNAL workspace, user ADMIN).
APEX_ADMIN_PASSWORD=ChangeMe_ApexAdmin123
APEX_ADMIN_EMAIL=admin@example.com

# Password for the APEX_PUBLIC_USER database account. ORDS's PL/SQL gateway
# (gateway-mode=direct) connects as this user with this actual password —
# it's not a display-only setting, both containers must agree on it.
# Avoid a double-quote character in this one (it's passed to SQL*Plus
# inside double quotes to allow other special characters through).
APEX_PUBLIC_USER_PASSWORD=ChangeMe_ApexPublic123

# Password ORDS sets on its own ORDS_PUBLIC_USER database account when it
# installs its schema. Only the ords container needs this one — it manages
# that user entirely on its own, nothing on the db side needs to match it.
ORDS_PUBLIC_USER_PASSWORD=ChangeMe_OrdsPublic123
